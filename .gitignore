# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Build/packaging output
/dist/
*.zip.tmp
# scripts/export_kml.py / scripts/export_html.py output - generated deliverables,
# not source
*.kmz
/*.html

# QGIS scratch files sometimes dropped alongside test GeoPackages
*.gpkg-shm
*.gpkg-wal
*.gpkg-journal

# GeoPackages/media folders from manual testing at the repo root (deploy.ps1 +
# real-zip imports for a quick eyeball check) - test suites always write to
# tmp_path, never here, so this can never catch a fixture by accident.
/*.gpkg
/*-media/
/*-kmz-unzipped/

# Editor/OS
.vscode/
.idea/
Thumbs.db

# sample.zip, multiple-photo-test-*.zip, and the release plugin zip are
# intentionally tracked, not ignored
